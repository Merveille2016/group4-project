# Server Port
PORT=5000

# MongoDB Connection String
# Replace <username>, <password>, and <dbname> with your actual credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# Session Secret
# Use a long, random string for your actual project
SESSION_SECRET=your_long_random_session_secret_here

# Frontend address(es) allowed to use the session cookie, comma separated
CLIENT_URL=http://localhost:5173,http://localhost:5174