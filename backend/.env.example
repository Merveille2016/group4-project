# Server Port
PORT=5000

# MongoDB Connection String
# Replace <username>, <password>, and <dbname> with your actual credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# Session Secret (required in production)
# Use a long, random string for your actual project
SESSION_SECRET=your_long_random_session_secret_here

# Key that encrypts 2FA secrets (required in production). Changing it breaks every enrolled authenticator.
TWO_FACTOR_KEY=your_long_random_two_factor_key_here

# Frontend address(es) allowed to use the cookies, comma separated
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Frontend address used in password reset links (defaults to the first CLIENT_URL)
# APP_URL=http://localhost:5173

# Minutes of inactivity before the session ends (default 5)
SESSION_IDLE_MINUTES=5

# Days a refresh token lasts (default 7)
REFRESH_TOKEN_DAYS=7

# Minutes a password reset link works (default 30)
PASSWORD_RESET_MINUTES=30

# Wrong passwords before an account locks, and for how long (defaults 5 and 15)
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Set when running behind a proxy (Render, Heroku, nginx) so rate limits see the real client IP
# TRUST_PROXY=1

# Email for password reset links. Leave SMTP_HOST unset in development and the
# link is printed in the server console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=UniGuide Cameroon <no-reply@uniguide.cm>

# Run tests against this MongoDB instead of a downloaded in-memory one.
# Tests only ever create and drop databases named uniguide_test_*.
# TEST_MONGO_URI=
